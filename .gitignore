# ---- Project specific ----------------------------------------------------------------------------------------------------
# QA runs, checkpoints and frame logs (campaign saves can contain profile ids).
/Artifacts/
# Blender autosave/backup copies; the .blend sources themselves are tracked.
*.blend1
*.blend2
# Python caches from the Tools scripts.
__pycache__/
*.pyc
# Local Claude/MCP wiring: contains machine-specific paths (user folder). Recreate it locally from CLAUDE.md.
/.mcp.json
/.claude/settings.local.json

# ---- Secrets: never commit ----------------------------------------------------------------------------------------------
.env
.env.*
*.pem
*.key
*.p12
*.pfx
*.keystore
*.jks
**/credentials*.json
**/*secret*.json
# Unity Services local auth caches
/[Aa]ssets/[Ss]treamingAssets/UnityServicesProjectConfiguration.json

# OS
.DS_Store
Thumbs.db
Desktop.ini
